# Скопируйте в .env — переменные подхватываются при запуске (уже заданные в окружении не перезаписываются).
# Пути можно задавать с ~ и $VAR. Всё необязательно: по умолчанию каталоги лежат внутри проекта.

# SD_ROOT=                     # корень проекта (по умолчанию — где лежит этот файл)
# SD_DATA=~/sd_data/data       # ваши записи (папки курение/ лжекурение/ …)
# SD_EXTERNAL=~/sd_data/ext    # открытые датасеты
# SD_MODELS=~/sd_data/models   # веса и пакеты моделей (большие файлы)
# SD_OUTPUTS=~/sd_data/outputs # кэши, прогоны, журнал экспериментов, база мониторинга
# SD_LABELS=~/sd_data/labels   # разметка (labels/events_gt.csv)
# SD_STREAMS=~/sd_data/streams # имитация камер для мониторинга: папки район-индекс-время
# SD_OLLAMA_URL=http://127.0.0.1:11434
# SD_THREADS=2
# SD_PROXY_CODEC=h264          # h264 | vp8 (WebM для браузеров без H.264)
# SD_WEB_ROOTS=             # дополнительные папки с видео для веб-приложения (через ; в Windows, : в Linux)
# SD_MAX_UPLOAD_GB=8          # предел размера загружаемого в веб-приложение видео
